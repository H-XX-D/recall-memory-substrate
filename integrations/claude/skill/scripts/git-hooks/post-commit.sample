#!/usr/bin/env bash
# post-commit.sample — Auto-extract Recall cells from changed Python files.
#
# Install:
#   cp .claude/skills/recall/scripts/git-hooks/post-commit.sample \
#      .git/hooks/post-commit
#   chmod +x .git/hooks/post-commit
#
# What it does:
#   On every commit, runs the Recall code extractor over the .py files
#   touched by HEAD and admits the resulting cells. Module and symbol
#   cells get updated views of the post-commit source.
#
# Behavior choices (edit to taste):
#   - Project label is the current repo directory name. Override by
#     setting RECALL_PROJECT in your shell environment.
#   - Only .py files are processed (Python extractor v1).
#   - --include-private is OFF by default; uncomment below to enable.
#   - Runs synchronously. If you want it async (commit returns
#     immediately, extraction happens in background), wrap the python3
#     call in `(... &)` or use `nohup`.
#   - Silent on success, prints errors to stderr.
#
# What it does NOT do:
#   - Idempotence: re-running on the same commit creates duplicate cells.
#     A future `--rebuild` flag will supersede prior cells for these files.
#   - Cross-language support: Python only in v1.
#   - Test results: hook this to CI separately for test→code links.
#   - Linker pass: typed relations between cells require a separate
#     `recall_code_link.py` run (not yet shipped).

set -e

SCRIPT="~/.claude/skills/recall/scripts/recall_code_extract.py"
DB="~/.recall/recall.sqlite3"
PROJECT="${RECALL_PROJECT:-$(basename "$(git rev-parse --show-toplevel)")}"

# Get changed .py files in the most recent commit (skip deletions)
changed_files=$(git diff-tree --no-commit-id --name-only --diff-filter=AMR -r HEAD | grep -E '\.py$' || true)

if [ -z "$changed_files" ]; then
  exit 0
fi

failures=0
for f in $changed_files; do
  if [ -f "$f" ]; then
    if ! python3 "$SCRIPT" --path "$f" --project "$PROJECT" --admit --db "$DB" >/dev/null 2>&1; then
      echo "recall post-commit: extraction failed for $f" >&2
      failures=$((failures + 1))
    fi
  fi
done

if [ "$failures" -gt 0 ]; then
  echo "recall post-commit: $failures file(s) failed extraction (commit succeeded)" >&2
fi

exit 0
