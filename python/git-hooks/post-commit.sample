#!/usr/bin/env bash
# post-commit.sample — Auto-extract Recall cells from changed Python files.
#
# Install:
#   cp <path-to-recall>/python/git-hooks/post-commit.sample \
#      .git/hooks/post-commit
#   chmod +x .git/hooks/post-commit
#
# Configuration (via environment variables or shell defaults below):
#   RECALL_SCRIPT_DIR — directory containing recall_code_extract.py
#                       (default: tries common install locations)
#   RECALL_DB         — path to Recall SQLite DB
#                       (default: ~/.recall/recall.sqlite3)
#   RECALL_PROJECT    — project label for cells
#                       (default: current repo's basename)
#
# What it does:
#   On every commit, runs the Recall code extractor over the .py files
#   touched by HEAD and admits the resulting cells.
#
# What it does NOT do:
#   - Idempotence: re-running on the same commit creates duplicate cells.
#     Use the extractor's --rebuild flag (in a separate manual pass) to
#     supersede prior cells via code-superseded-by hyperedges.
#   - Cross-language support: Python only in this hook. For JS/TS, use
#     recall_code_extract_js.py (analogous hook can be adapted from this).
#   - Test results: hook this to CI separately via recall_ci_ingest.py.

set -e

# Resolve script directory: try env var, then common install locations
SCRIPT_DIR="${RECALL_SCRIPT_DIR:-}"
if [ -z "$SCRIPT_DIR" ]; then
  for candidate in \
    "$HOME/.local/share/recall/python/scripts" \
    "/usr/local/share/recall/python/scripts" \
    "/opt/recall/python/scripts" \
    "$HOME/recall/python/scripts"; do
    if [ -f "$candidate/recall_code_extract.py" ]; then
      SCRIPT_DIR="$candidate"
      break
    fi
  done
fi

if [ -z "$SCRIPT_DIR" ] || [ ! -f "$SCRIPT_DIR/recall_code_extract.py" ]; then
  echo "recall post-commit: cannot find recall_code_extract.py" >&2
  echo "  set RECALL_SCRIPT_DIR env var to its directory and retry" >&2
  exit 0   # don't block commit on hook configuration issues
fi

SCRIPT="$SCRIPT_DIR/recall_code_extract.py"
DB="${RECALL_DB:-$HOME/.recall/recall.sqlite3}"
PROJECT="${RECALL_PROJECT:-$(basename "$(git rev-parse --show-toplevel)")}"

# Get changed .py files in the most recent commit (skip deletions)
changed_files=$(git diff-tree --no-commit-id --name-only --diff-filter=AMR -r HEAD | grep -E '\.py$' || true)

if [ -z "$changed_files" ]; then
  exit 0
fi

failures=0
for f in $changed_files; do
  if [ -f "$f" ]; then
    if ! python3 "$SCRIPT" --path "$f" --project "$PROJECT" --admit --db "$DB" >/dev/null 2>&1; then
      echo "recall post-commit: extraction failed for $f" >&2
      failures=$((failures + 1))
    fi
  fi
done

if [ "$failures" -gt 0 ]; then
  echo "recall post-commit: $failures file(s) failed extraction (commit succeeded)" >&2
fi

exit 0
